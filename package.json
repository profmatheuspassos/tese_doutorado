{
  "name": "tese-doutorado-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/conferir-dados.mjs && node scripts/conferir-contraste.mjs",
    "build": "astro check && astro build",
    "postbuild": "node scripts/conferir-texto.mjs && node scripts/conferir-terceiros.mjs",
    "preview": "astro preview",
    "conferir": "npm run build",
    "capturas": "node scripts/capturas.mjs B0,B1,B2,B3,B4",
    "imagens": "node scripts/reservar-imagens.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.12",
    "gsap": "3.15.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3"
  }
}
