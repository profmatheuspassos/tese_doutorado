---
/**
 * Capítulo 3 — O atalho que não resolve.
 * B2: imagem do estádio com a legenda T33 (D24, D55). B6: a bolha (interativo). B8: tabela dos
 * sete problemas, que vira cartões no celular.
 */
import Capitulo from '../../layouts/Capitulo.astro';
import BlocoTexto from '../capitulo/BlocoTexto.astro';
import Imagem from '../site/Imagem.astro';
import Bolha from '../interativos/Bolha.astro';
import { pagina, tituloNaTese } from '../../lib/paginas';
import { rotularCelulas, usarBlocos } from '../../lib/blocos';
import { rotulosDe } from '../../i18n';
import { ancora } from '../../lib/ancoras';
const { t, idioma } = rotulosDe(Astro.url);

const { dados: meta, blocos } = await pagina('capitulo-3', idioma);
const naTese = await tituloNaTese('capitulo-3', idioma);
const { b, conferir } = usarBlocos(blocos, 'capitulo-3');
const B0 = b('B0');
const [B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11] = ['B1', 'B2', 'B3', 'B4', 'B5', 'B6', 'B7', 'B8', 'B9', 'B10', 'B11'].map(b);
conferir();

// B2 — o estádio entra depois do primeiro parágrafo ("... é impossível").
if (!B2.elementos[1]?.includes(ancora('capitulo-3', 'impossivel', idioma))) throw new Error('capitulo-3 B2: o primeiro parágrafo mudou de lugar.');
// B6 — a bolha entra depois do último parágrafo.
const fimB6 = B6.elementos.length - 1;
// B8 — tabela dos sete problemas.
const iTabela = B8.elementos.findIndex((el) => el.startsWith('<table'));
if (iTabela < 1) throw new Error('capitulo-3 B8: tabela não encontrada.');
const tabela = (el: string, i: number) => (i === iTabela ? rotularCelulas(el) : el);
---
<Capitulo rota={meta.rota} titulo={meta.titulo} abertura={B0} n={meta.capitulo} tituloOriginal={naTese.original} traducaoTituloOriginal={naTese.traducao} langTituloOriginal={naTese.langOriginal} imagem="cap3-abertura.webp" tema="escuro">
  <BlocoTexto bloco={B1} />
  <BlocoTexto bloco={B2}>
    <figure slot="apos-1" class="estadio largo" data-ui>
      <Imagem nome="cap3-estadio.webp" largura={2400} altura={1350} sizes="(min-width: 960px) 896px, 100vw" class="estadio-imagem" />
      <figcaption class="estadio-legenda">{t('estadio_legenda')}</figcaption>
    </figure>
  </BlocoTexto>
  <BlocoTexto bloco={B3} />
  <BlocoTexto bloco={B4} />
  <BlocoTexto bloco={B5} />
  <BlocoTexto bloco={B6}>
    <Bolha slot={`apos-${fimB6}`} />
  </BlocoTexto>
  <BlocoTexto bloco={B7} />
  <BlocoTexto bloco={B8} transformar={tabela} />
  <BlocoTexto bloco={B9} />
  <BlocoTexto bloco={B10} />
  <BlocoTexto bloco={B11} />
</Capitulo>

<style is:global>
  .estadio-imagem {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-cartao);
    background: var(--color-nevoa);
  }
  .estadio-legenda {
    margin-top: 0.85rem;
    max-width: 40rem;
    font-size: var(--text-pequeno);
    line-height: 1.5;
    color: var(--color-tinta-2);
  }
  .texto table.tabela-cartoes td[data-col='0'] { width: 42%; }
</style>
