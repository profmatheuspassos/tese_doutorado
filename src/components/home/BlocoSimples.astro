---
/**
 * Tratamento provisório (Etapa 1): mostra o bloco aprovado com a tipografia base,
 * até receber o desenho próprio nas Etapas 2 e 3.
 */
import type { Bloco } from '../../lib/blocos';
import LinkCapitulo from './LinkCapitulo.astro';
interface Props { bloco: Bloco; tom: 'clara' | 'nevoa' | 'escura'; capitulo?: number }
const { bloco, tom, capitulo } = Astro.props;
---
<section class:list={[`secao-${tom}`, 'respiro']} data-bloco={bloco.id}>
  <div class="margem mx-auto max-w-(--container-figura)">
    <div class="texto max-w-(--container-texto)" set:html={bloco.html} />
    {capitulo && <LinkCapitulo n={capitulo} class="mt-10" />}
  </div>
</section>
