---
import type { Bloco } from '../../lib/blocos';
import { anexarEmCadaItem, comAtributos, envolverTrecho } from '../../lib/blocos';
import { t } from '../../i18n';
import LinkCapitulo from './LinkCapitulo.astro';

interface Props { bloco: Bloco }
const { bloco } = Astro.props;
const [h2, pIntro, lista, pGoverno, pFinal, ...resto] = bloco.elementos;
if (!h2?.startsWith('<h2') || !lista?.startsWith('<ul') || !pFinal || resto.length) throw new Error('B2 fora do formato esperado.');

// Duas marcas de "cumpre" por regra: Portugal (ramo) e Brasil (semente). Desenhos sem texto.
const marca = (pais: 'pt' | 'br') =>
  `<svg class="marca marca-${pais}" viewBox="0 0 24 24" fill="none"><circle class="marca-circulo" cx="12" cy="12" r="10.5"/><path class="marca-visto" pathLength="1" d="M7.5 12.4l3.1 3.1 6-6.4"/></svg>`;
const marcas = `<span class="marcas" aria-hidden="true">${marca('pt')}${marca('br')}</span>`;
const listaComMarcas = comAtributos(anexarEmCadaItem(lista, marcas), { class: 'checklist', 'data-checklist': '' });
const r = (el: string) => comAtributos(el, { 'data-revelar': '' });
---
<section class="secao-nevoa respiro" data-bloco="B2">
  <div class="margem mx-auto max-w-(--container-figura)">
    <div class="texto max-w-[46rem]">
      <Fragment set:html={r(h2)} />
      <Fragment set:html={r(pIntro)} />

      <div class="checklist-legenda" aria-hidden="true">
        <span><i class="ponto-pais bg-ramo"></i>{t('paises.portugal')}</span>
        <span><i class="ponto-pais bg-semente"></i>{t('paises.brasil')}</span>
      </div>
      <Fragment set:html={listaComMarcas} />

      <Fragment set:html={r(pGoverno)} />
      <Fragment set:html={comAtributos(envolverTrecho(pFinal, 'No papel, são democracias.', 'no-papel-destaque'), { 'data-revelar': '', class: 'no-papel-final' })} />
      <LinkCapitulo n={1} class="mt-10" />
    </div>
  </div>
</section>

<style is:global>
  .checklist-legenda {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 2rem;
    margin-bottom: 0.625rem;
    padding-right: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-tinta-2);
  }
  .checklist-legenda span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ponto-pais {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
  }
  .texto ul.checklist {
    background: var(--color-branco);
    border: 1px solid color-mix(in srgb, var(--color-tinta) 8%, transparent);
    border-radius: var(--radius-cartao);
    box-shadow: 0 1px 2px rgb(15 17 20 / 0.04), 0 8px 24px -16px rgb(15 17 20 / 0.12);
    margin-bottom: 2rem;
    overflow: hidden;
  }
  .texto ul.checklist > li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.95rem 1.25rem;
    line-height: 1.45;
  }
  .texto ul.checklist > li + li {
    border-top: 1px solid color-mix(in srgb, var(--color-tinta) 8%, transparent);
  }
  .texto ul.checklist > li::before {
    display: none;
  }
  .marcas {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0.5rem;
  }
  .marca {
    width: 1.5rem;
    height: 1.5rem;
  }
  .marca-circulo {
    stroke-width: 1.5;
  }
  .marca-visto {
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .marca-pt .marca-circulo { stroke: var(--color-ramo); fill: color-mix(in srgb, var(--color-ramo) 12%, transparent); }
  .marca-pt .marca-visto { stroke: var(--color-ramo); }
  .marca-br .marca-circulo { stroke: var(--color-semente); fill: color-mix(in srgb, var(--color-semente) 12%, transparent); }
  .marca-br .marca-visto { stroke: var(--color-semente); }
  .no-papel-final {
    font-size: var(--text-destaque);
    line-height: var(--text-destaque--line-height);
  }
  .no-papel-destaque {
    font-weight: 700;
    color: var(--color-tinta);
  }
</style>
