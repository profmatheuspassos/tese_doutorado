---
/**
 * Ramo fino (Portugal, D1): existe, mas é frágil. Desenho decorativo, sem texto.
 * Cada traço tem pathLength=1 para a animação de desenho (stroke-dashoffset).
 */
interface Props { class?: string }
const { class: classe } = Astro.props;
const folha = 'M0 0C7-9 21-9 30 0C21 9 7 9 0 0Z';
const folhas = [
  { x: 74, y: 252, r: -140 },
  { x: 196, y: 142, r: -35 },
  { x: 176, y: 374, r: -40 },
  { x: 120, y: 66, r: -120 },
  { x: 153, y: 40, r: -80 },
];
---
<svg class={classe} viewBox="0 0 240 560" fill="none" aria-hidden="true" focusable="false" data-ramo>
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path class="traco" pathLength="1" stroke-width="1.75" vector-effect="non-scaling-stroke"
      d="M118 560C112 470 132 400 126 320S150 170 152 40" />
    <path class="traco" pathLength="1" stroke-width="1.25" vector-effect="non-scaling-stroke"
      d="M126 318C110 300 92 274 74 252" />
    <path class="traco" pathLength="1" stroke-width="1.25" vector-effect="non-scaling-stroke"
      d="M140 204C158 186 178 160 196 142" />
    <path class="traco" pathLength="1" stroke-width="1.25" vector-effect="non-scaling-stroke"
      d="M128 422C142 406 160 388 176 374" />
    <path class="traco" pathLength="1" stroke-width="1.25" vector-effect="non-scaling-stroke"
      d="M150 104C140 90 130 78 120 66" />
  </g>
  <g class="folhas">
    {folhas.map((f) => (
      <path class="folha" d={folha} transform={`translate(${f.x} ${f.y}) rotate(${f.r})`}
        fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.25"
        vector-effect="non-scaling-stroke" />
    ))}
  </g>
</svg>
