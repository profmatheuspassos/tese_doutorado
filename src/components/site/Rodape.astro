---
import { rotulosDe } from '../../i18n';
import { idioma as dadosIdioma } from '../../lib/idiomas.mjs';
import { navegacao, url } from '../../lib/paginas';
import Sementes from '../motivo/Sementes.astro';
import SeletorIdioma from './SeletorIdioma.astro';

// seletor: rota de destino do seletor de idioma, que fica sempre no rodapé quando existe (D101).
interface Props { comTexto?: boolean; seletor?: string }
const { comTexto = false, seletor } = Astro.props;
const { t, idioma } = rotulosDe(Astro.url);
const nav = await navegacao(idioma);
const caps = nav.capitulos;
const pSobre = nav.sobre;
// Contato aprovado na decisão D7.
const contato = 'contato@profmatheus.com';

// Linha de licença (T49, D76): os nomes das licenças viram links, sem mudar o texto aprovado.
const LINKS_LICENCA: [string, string][] = [
  ['CC BY-NC-ND 4.0', dadosIdioma(idioma).licencaCc],
  ['MIT', 'https://github.com/profmatheuspassos/tese_doutorado/blob/main/LICENSE'],
];
const licenca: { texto: string; href?: string }[] = [];
let resto = t('licenca');
for (const [nome, href] of LINKS_LICENCA) {
  const i = resto.indexOf(nome);
  if (i < 0) throw new Error(`T49 sem "${nome}"`);
  licenca.push({ texto: resto.slice(0, i) }, { texto: nome, href });
  resto = resto.slice(i + nome.length);
}
licenca.push({ texto: resto });
---
<footer class="secao-escura">
  <div class="margem mx-auto max-w-(--container-figura) py-16 md:py-20">
    <Sementes class="mb-10 h-6 w-28 text-semente-escuro" />
    <div class:list={['grid gap-12', comTexto && 'md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]']}>
      {comTexto && (
        <div class="max-w-(--container-texto)">
          <slot />
        </div>
      )}
      <nav data-ui aria-label={t('menu')} class="text-pequeno">
        <ul class="grid gap-2.5 sm:grid-cols-2">
          <li><a class="text-gelo-2 hover:text-gelo" href={url(nav.inicio.rota)}>{t('inicio')}</a></li>
          {caps.map((c) => (
            <li>
              <a class="text-gelo-2 hover:text-gelo" href={url(c.rota)}>
                <span class="block text-[0.8125rem] text-linha-escuro">{t('capitulo', { n: c.n })}</span>
                {c.lang ? <span lang={c.lang}>{c.titulo}</span> : c.titulo}
              </a>
            </li>
          ))}
          <li><a class="text-gelo-2 hover:text-gelo" href={url(pSobre.rota)} lang={pSobre.lang}>{pSobre.titulo}</a></li>
        </ul>
        <p class="mt-8"><a class="text-gelo underline underline-offset-4" href={`mailto:${contato}`}>{contato}</a></p>
        <p class="mt-6 text-[0.8125rem] text-gelo-2" data-rotulo>{licenca.map((p) => (p.href ? <a class="underline underline-offset-4 hover:text-gelo" href={p.href}>{p.texto}</a> : p.texto))}</p>
        {seletor && <SeletorIdioma destino={seletor} tema="escuro" class="mt-6" />}
      </nav>
    </div>
  </div>
</footer>
