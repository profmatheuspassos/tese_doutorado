---
/**
 * Linha do tempo do capítulo 1 (B1): súdito → governo representativo → democracia
 * representativa (T18). Repete o que o texto do bloco conta, por isso é aria-hidden.
 * Cor neutra (tinta): vale para os dois países. Horizontal a partir de 640 px; vertical no
 * celular. Os nós aparecem em sequência ao entrar na tela (data-anima, só com movimento normal).
 */
import { lista } from '../../i18n';

const etapas = lista('linha_do_tempo');
if (etapas.length !== 3) throw new Error('A linha do tempo precisa de três etapas (T18).');
---
<div class="linha-tempo largo" aria-hidden="true" data-ui data-anima>
  {etapas.map((etapa, i) => (
    <div class="linha-tempo-etapa" style={`--i:${i}`}>
      <span class="linha-tempo-no" data-ultimo={i === etapas.length - 1 ? '' : undefined}></span>
      <span class="linha-tempo-rotulo">{etapa}</span>
    </div>
  ))}
</div>

<style is:global>
  .linha-tempo {
    display: grid;
    gap: 0;
    max-width: 44rem !important;
  }
  .linha-tempo-etapa {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.75rem;
  }
  .linha-tempo-etapa:last-child { padding-bottom: 0; }
  /* traço entre os nós (vertical no celular) */
  .linha-tempo-etapa:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.6875rem;
    top: 1.75rem;
    bottom: 0.25rem;
    width: 2px;
    background: color-mix(in srgb, var(--color-tinta) 35%, transparent);
  }
  /* ponta de seta no fim do traço (para baixo no celular, para a direita no resto) */
  .linha-tempo-etapa:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    bottom: 0.3rem;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid color-mix(in srgb, var(--color-tinta) 35%, transparent);
    border-bottom: 2px solid color-mix(in srgb, var(--color-tinta) 35%, transparent);
    transform: rotate(45deg);
  }
  .linha-tempo-no {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 2px solid var(--color-tinta);
    background: var(--color-branco);
  }
  .linha-tempo-no[data-ultimo] { background: var(--color-tinta); }
  .linha-tempo-rotulo {
    font-size: var(--text-pequeno);
    font-weight: 650;
    line-height: 1.3;
    color: var(--color-tinta);
  }
  @media (min-width: 640px) {
    .linha-tempo { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .linha-tempo-etapa {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.85rem;
      padding-bottom: 0;
    }
    .linha-tempo-etapa:not(:last-child)::after {
      left: calc(50% + 1.1rem);
      right: calc(-50% + 1.1rem);
      top: 0.6875rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .linha-tempo-etapa:not(:last-child)::before {
      left: auto;
      right: calc(-50% + 1.15rem);
      top: 0.5rem;
      bottom: auto;
      transform: rotate(-45deg);
    }
  }
</style>

<script>
  import '../../scripts/comum/visuais';
</script>
