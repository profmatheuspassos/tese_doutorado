---
import type { Bloco } from '../../lib/blocos';
import { comAtributos, envolverTrecho } from '../../lib/blocos';
import { url } from '../../lib/paginas';
import { ancora } from '../../lib/ancoras';
import { idiomaAtual } from '../../i18n';

const idioma = idiomaAtual(Astro.url);

interface Props { bloco: Bloco }
const { bloco } = Astro.props;
const [h2, p1, p2, p3, ...resto] = bloco.elementos;
if (!h2?.startsWith('<h2') || !p3 || resto.length) throw new Error('B1 fora do formato esperado (h2 + 3 parágrafos).');
const r = (el: string, extra: Record<string, string> = {}) => comAtributos(el, { 'data-revelar': '', ...extra });
---
<section class="secao-escura respiro" data-bloco="B1">
  <div class="margem mx-auto grid max-w-(--container-figura) gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <img
        data-cena-imagem
        src={url('/img/home-cena-2013.webp')}
        width="1200"
        height="1500"
        alt=""
        loading="lazy"
        decoding="async"
        class="cena-imagem aspect-[4/5] max-h-[60svh] w-full rounded-cartao border border-linha-escuro/30 object-cover lg:max-h-[calc(100svh-8rem)]"
      />
    </div>
    <div class="texto cena-texto">
      <Fragment set:html={r(h2)} />
      <Fragment set:html={r(p1, { 'data-passo': '1' })} />
      <Fragment set:html={r(p2, { 'data-passo': '2' })} />
      <Fragment set:html={r(envolverTrecho(p3, ancora('home', 'naoBasta', idioma),'cena-nao-basta'), { 'data-passo': '3' })} />
    </div>
  </div>
</section>

<style is:global>
  /* Sem JS ou com movimento reduzido, a imagem já aparece em tons de cinza. */
  .cena-imagem {
    filter: grayscale(1);
    background: var(--color-grafite-2);
  }
  .cena-texto p {
    font-size: var(--text-destaque);
    line-height: var(--text-destaque--line-height);
  }
  @media (min-width: 1024px) {
    .cena-texto [data-passo] {
      margin-bottom: 22vh;
    }
    .cena-texto [data-passo='3'] {
      margin-bottom: 0;
    }
    .cena-texto h2 {
      margin-bottom: 12vh;
    }
  }
  .cena-nao-basta {
    display: block;
    font-size: var(--text-titulo);
    line-height: var(--text-titulo--line-height);
    letter-spacing: var(--text-titulo--letter-spacing);
    font-weight: 750;
    color: var(--color-gelo);
    margin-bottom: 0.75rem;
  }
</style>
