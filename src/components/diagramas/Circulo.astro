---
/**
 * Círculo de três nós ligados por arcos com seta.
 * "vicioso" (B4): setas no sentido horário. "virtuoso" (B6, Etapa 3): sentido inverso.
 * Rótulos T8/T9 em HTML sobre o SVG. Tudo aria-hidden: o texto do bloco já diz o mesmo.
 */
import { lista } from '../../i18n';

interface Props { estado: 'vicioso' | 'virtuoso'; class?: string }
const { estado, class: classe } = Astro.props;
const rotulos = lista(`circulo_${estado}`);
if (rotulos.length !== 3) throw new Error('O círculo precisa de três rótulos.');

const C = 200;
const R = 120;
const angulos = [-90, 30, 150]; // alto, direita embaixo, esquerda embaixo
const rad = (g: number) => (g * Math.PI) / 180;
const ponto = (g: number) => [C + R * Math.cos(rad(g)), C + R * Math.sin(rad(g))].map((v) => Math.round(v * 10) / 10);
const folga = 17; // graus livres em volta de cada nó
const arcos = angulos.map((a, i) => {
  const [x1, y1] = ponto(a + folga);
  const [x2, y2] = ponto(angulos[(i + 1) % 3] + (i === 2 ? 360 : 0) - folga);
  return `M${x1} ${y1}A${R} ${R} 0 0 1 ${x2} ${y2}`;
});
const nos = angulos.map(ponto);
// Posição de cada nó em % da caixa, para os rótulos ficarem junto dos nós.
const pct = nos.map(([x, y]) => [(x / 400) * 100, (y / 400) * 100]);
const marcador = estado === 'vicioso' ? { 'marker-end': 'url(#seta)' } : { 'marker-start': 'url(#seta-inversa)' };
---
<div class:list={['circulo', `circulo-${estado}`, classe]} aria-hidden="true" data-circulo data-ativo="todos">
  <svg viewBox="0 0 400 400" fill="none" focusable="false">
    <defs>
      <marker id="seta" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M1 1L8 5L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </marker>
      <marker id="seta-inversa" viewBox="0 0 10 10" refX="3" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1 1L8 5L1 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </marker>
    </defs>
    <circle class="circulo-anel" cx={C} cy={C} r={R} />
    <g class="circulo-arcos">
      {arcos.map((d) => <path class="circulo-arco" d={d} {...marcador} />)}
    </g>
    <g class="circulo-fluxo" data-fluxo>
      {[0, 120, 240].map((a) => { const [x, y] = ponto(a - 30); return <circle cx={x} cy={y} r="3" />; })}
    </g>
    {nos.map(([x, y], i) => (
      <g class="circulo-no" data-no={i}>
        <circle class="circulo-no-halo" cx={x} cy={y} r="24" />
        <circle class="circulo-no-ponto" cx={x} cy={y} r="11" />
      </g>
    ))}
  </svg>
  {rotulos.map((r, i) => (
    <p
      class:list={['circulo-rotulo', `circulo-rotulo-${i}`]}
      data-no={i}
      style={i === 0
        ? `left:${pct[0][0]}%;bottom:calc(${100 - pct[0][1]}% + 1.9rem)`
        : `left:${pct[i][0]}%;top:calc(${((C + R) / 400) * 100}% + 0.75rem)`}
    >{r}</p>
  ))}
</div>

<style is:global>
  .circulo {
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    margin-block: 1rem;
    color: var(--color-linha-escuro);
  }
  .circulo svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .circulo-anel {
    stroke: color-mix(in srgb, var(--color-linha-escuro) 22%, transparent);
    stroke-width: 1;
  }
  .circulo-arco {
    stroke: var(--color-gelo-2);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .circulo-arcos {
    color: var(--color-gelo-2);
  }
  .circulo-fluxo circle {
    fill: var(--color-gelo);
    opacity: 0;
  }
  .circulo-no-halo {
    fill: color-mix(in srgb, var(--color-gelo) 10%, transparent);
    transition: opacity 0.4s ease, transform 0.4s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .circulo-no-ponto {
    fill: var(--color-gelo);
    stroke: var(--color-grafite);
    stroke-width: 3;
    transition: fill 0.4s ease;
  }
  .circulo-rotulo {
    position: absolute;
    width: max-content;
    max-width: min(9.5rem, 44%);
    transform: translateX(-50%);
    text-align: center;
    font-size: var(--text-pequeno);
    line-height: 1.3;
    font-weight: 650;
    color: var(--color-gelo);
    text-wrap: balance;
    transition: color 0.4s ease;
  }

  /* Nó em destaque: os outros esmaecem. Padrão (sem JS): todos acesos. */
  .circulo:not([data-ativo='todos']) .circulo-no:not(.ativo) .circulo-no-ponto { fill: var(--color-grafite-2); stroke: var(--color-linha-escuro); stroke-width: 1.5; }
  .circulo:not([data-ativo='todos']) .circulo-no:not(.ativo) .circulo-no-halo { opacity: 0; }
  .circulo:not([data-ativo='todos']) .circulo-rotulo:not(.ativo) { color: var(--color-linha-escuro); }
</style>
