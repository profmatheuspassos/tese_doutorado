---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';
import LinkPular from '../components/site/LinkPular.astro';
import Cabecalho from '../components/site/Cabecalho.astro';
import Rodape from '../components/site/Rodape.astro';
import { inicioDe, parDe, url } from '../lib/paginas';
import { getEntry } from 'astro:content';
import { IMAGEM_OG } from '../lib/imagens.mjs';
import { idioma as dadosIdioma, IDIOMA_PADRAO, outroIdioma } from '../lib/idiomas.mjs';
import { inglesAtivo } from '../lib/site.mjs';
import { idiomaAtual } from '../i18n';

interface Props {
  titulo: string; // <title> completo (T11)
  descricao?: string; // T12
  indexar?: boolean; // false na 404: sem canonical, sem metadados de compartilhamento, noindex
}
const { titulo, descricao, indexar = true } = Astro.props;

// Idioma da página, pela rota (D91): lang do <html>, og:locale e nome do site.
const idioma = idiomaAtual(Astro.url);
const dadosDoIdioma = dadosIdioma(idioma);

// Endereço canônico e compartilhamento (D72, D73). Só textos já aprovados: o <title> (T11), a
// descrição (T12 ou a da página) e o título da home do idioma como nome do site.
if (!Astro.site) throw new Error('Falta o "site" no astro.config.mjs.');
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const imagemOg = new URL(url(`/img/${IMAGEM_OG.nome}`), Astro.site).href;
const nomeSite = indexar ? (await getEntry(dadosDoIdioma.colecao, 'home'))?.data.titulo : undefined;
if (indexar && !nomeSite) throw new Error(`Página "home" (${idioma}) sem título para o og:site_name.`);

// Versão em inglês (D91, D92, D108): só com o inglês ativo. Página com par: seletor para o par,
// hreflang pt-BR, en e x-default (português) e og:locale:alternate. 404: seletor para o início do
// outro idioma, se ele existe, sem hreflang. Sem par, nada.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rotaAtual = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const outro = outroIdioma(idioma);
const par = inglesAtivo() && indexar ? await parDe(rotaAtual, idioma) : undefined;
const destinoSeletor = !inglesAtivo() ? undefined : indexar ? par : await inicioDe(outro);
const alternativas = par
  ? [
      { hreflang: dadosDoIdioma.hreflang, href: canonica },
      { hreflang: dadosIdioma(outro).hreflang, href: new URL(url(par), Astro.site).href },
    ].sort((a, b) => (a.hreflang === dadosIdioma(IDIOMA_PADRAO).hreflang ? -1 : b.hreflang === dadosIdioma(IDIOMA_PADRAO).hreflang ? 1 : 0))
  : [];
const xDefault = alternativas.find((a) => a.hreflang === dadosIdioma(IDIOMA_PADRAO).hreflang)?.href;

// Fonte Inter Variable servida pelo próprio site (só latim e latim estendido).
const fontes = `
@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:"Inter Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatinExt}) format("woff2-variations");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}`;

// Marca o <html> com "js" e, se as animações não confirmarem a carga em 3 s,
// libera todo o conteúdo (classe "anim-falhou").
const marcaJs = `document.documentElement.classList.add('js');setTimeout(function(){var h=document.documentElement;if(!h.classList.contains('anim-pronto'))h.classList.add('anim-falhou')},3000);`;
---
<!doctype html>
<html lang={dadosDoIdioma.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    {indexar ? (
      <>
        <link rel="canonical" href={canonica} />
        {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonica} />
        <meta property="og:title" content={titulo} />
        {descricao && <meta property="og:description" content={descricao} />}
        <meta property="og:image" content={imagemOg} />
        <meta property="og:image:width" content={String(IMAGEM_OG.largura)} />
        <meta property="og:image:height" content={String(IMAGEM_OG.altura)} />
        <meta property="og:locale" content={dadosDoIdioma.ogLocale} />
        {par && <meta property="og:locale:alternate" content={dadosIdioma(outro).ogLocale} />}
        <meta property="og:site_name" content={nomeSite} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    ) : <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontes}></style>
    <script is:inline set:html={marcaJs}></script>
  </head>
  <body class="antialiased">
    <LinkPular />
    <Cabecalho seletor={destinoSeletor} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    {Astro.slots.has('rodape') ? (
      <Rodape comTexto seletor={destinoSeletor}>
        <slot name="rodape" />
      </Rodape>
    ) : <Rodape seletor={destinoSeletor} />}
  </body>
</html>
