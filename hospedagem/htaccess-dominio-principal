# .htaccess da pasta principal do domínio profmatheuspassos.com.br (public_html), na Hostinger.
# Decisão D77. Copiar este conteúdo, sem mudanças, para public_html/.htaccess (docs/PUBLICACAO.md).
#
# Só mod_rewrite, sempre com condição de host: o subdomínio tese.profmatheuspassos.com.br, cuja
# pasta fica dentro desta, nunca é redirecionado. Nada de Redirect/RedirectMatch (mod_alias) nem
# de Header aqui: seriam herdados pela pasta do subdomínio.

RewriteEngine On

# profmatheuspassos.com.br/tese/... vai para o subdomínio, no mesmo caminho.
RewriteCond %{HTTP_HOST} ^(www\.)?profmatheuspassos\.com\.br$ [NC]
RewriteRule ^tese(?:/(.*))?$ https://tese.profmatheuspassos.com.br/$1 [R=301,L,NE]

# O resto do domínio principal e do www vai para profmatheus.com, no mesmo caminho.
# O .well-known fica de fora, para a renovação do certificado SSL deste domínio.
RewriteCond %{HTTP_HOST} ^(www\.)?profmatheuspassos\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://profmatheus.com%{REQUEST_URI} [R=301,L,NE]
