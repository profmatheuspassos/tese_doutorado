---
/** Broto pequeno, sem florada (fecho da home): uma semente que acabou de brotar. Decorativo. */
interface Props { class?: string }
const { class: classe } = Astro.props;
const folha = 'M0 0C6-8 18-8 26 0C18 8 6 8 0 0Z';
---
<svg class={classe} viewBox="0 0 80 100" fill="none" aria-hidden="true" focusable="false" data-broto-final>
  <path d="M10 86H70" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" opacity="0.5" vector-effect="non-scaling-stroke" />
  <g transform="translate(40 80) rotate(8)">
    <path d="M0-8C4.5-8 6-2.7 6 1C6 5.5 3.2 8 0 8S-6 5.5-6 1C-6-2.7-4.5-8 0-8Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </g>
  <path class="broto-caule" pathLength="1" d="M41 72C39 58 43 46 41 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <path class="broto-folha" d={folha} transform="translate(41 42) rotate(-150)" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
  <path class="broto-folha" d={folha} transform="translate(41 34) rotate(-35)" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
</svg>
