---
/**
 * "Sobre a tese" (plano da Fase 4, seção 3). Mesmo modelo das páginas internas, sem imagem e
 * sem número de capítulo; o motivo das sementes acompanha a abertura.
 * B2: a ficha vira cartão de duas colunas (chave em cinza); a linha de cabeçalho vazia do .md
 * fica aria-hidden e some da tela. B6: as três referências, com quebra de linha no celular,
 * título em negrito no ABNT e em itálico no APA (envoltórios, sem trocar palavra) e um botão
 * "Copiar" por formato (T43 a T48). B7: cartão com o link de contato do próprio texto.
 */
import Capitulo from '../layouts/Capitulo.astro';
import BlocoTexto from '../components/capitulo/BlocoTexto.astro';
import Sementes from '../components/motivo/Sementes.astro';
import Copiar from '../components/interativos/Copiar.astro';
import { pagina } from '../lib/paginas';
import { atributosEmTag, atributosNaColuna, comAtributos, envolverTrecho, usarBlocos } from '../lib/blocos';

const { dados: meta, blocos } = await pagina('sobre');
const { b, conferir } = usarBlocos(blocos, 'sobre');
const B0 = b('B0');
const [B1, B2, B3, B4, B5, B6, B7] = ['B1', 'B2', 'B3', 'B4', 'B5', 'B6', 'B7'].map(b);
conferir();

// B2 — ficha.
const iFicha = B2.elementos.findIndex((el) => el.startsWith('<table'));
if (iFicha < 1 || !/<thead>\s*<tr>\s*<th><\/th>\s*<th><\/th>\s*<\/tr>\s*<\/thead>/.test(B2.elementos[iFicha])) throw new Error('sobre B2: esperada a tabela da ficha com cabeçalho vazio.');
const ficha = (el: string, i: number) => (i === iFicha
  ? comAtributos(atributosNaColuna(atributosEmTag(el, 'thead', { 'aria-hidden': 'true' }), 0, { role: 'rowheader' }), { class: 'ficha' })
  : el);

// B6 — as três referências: cada bloco <pre> segue o rótulo em negrito do formato.
const formatos = ['ABNT', 'APA', 'BibTeX'] as const;
const titulos: Record<string, string> = {
  ABNT: 'Cidadania Ativa e Governança sob a perspectiva do Direito Eleitoral comparado',
  APA: 'Cidadania ativa e governança sob a perspectiva do direito eleitoral comparado',
};
const indices = formatos.map((f) => {
  const i = B6.elementos.findIndex((el) => el === `<p><strong>${f}</strong></p>`);
  if (i < 1 || !B6.elementos[i + 1]?.startsWith('<pre')) throw new Error(`sobre B6: referência ${f} fora do formato esperado.`);
  return i + 1;
});
const idDe = (f: string) => `citacao-${f.toLowerCase()}`;
const citacoes = (el: string, i: number) => {
  const k = indices.indexOf(i);
  if (k < 0) return el;
  const f = formatos[k];
  const comTitulo = titulos[f] ? envolverTrecho(el, titulos[f], `cit-titulo cit-titulo-${f.toLowerCase()}`) : el;
  return comAtributos(comTitulo, { id: idDe(f), class: 'citacao' });
};

// B7 — contato.
const iContato = B7.elementos.findIndex((el) => el.includes('mailto:'));
if (iContato < 1) throw new Error('sobre B7: link de contato não encontrado.');
const contato = (el: string, i: number) => (i === iContato ? comAtributos(el, { class: 'contato-cartao' }) : el);
---
<Capitulo rota={meta.rota} titulo={meta.titulo} abertura={B0} tema="nevoa">
  <Sementes slot="lateral" class="sobre-sementes text-semente" quantidade={5} />

  <BlocoTexto bloco={B1} />
  <BlocoTexto bloco={B2} transformar={ficha} />
  <BlocoTexto bloco={B3} />
  <BlocoTexto bloco={B4} />
  <BlocoTexto bloco={B5} />
  <BlocoTexto bloco={B6} transformar={citacoes}>
    {formatos.map((f, k) => <Copiar slot={`apos-${indices[k]}`} formato={f} alvo={idDe(f)} />)}
  </BlocoTexto>
  <BlocoTexto bloco={B7} transformar={contato} />
</Capitulo>

<style is:global>
  .sobre-sementes { display: block; width: min(16rem, 60%); height: auto; margin-inline: auto; }

  /* Ficha: cartão de duas colunas, chave em cinza. */
  .texto table.ficha {
    background: var(--color-nevoa);
    border-radius: var(--radius-cartao);
    overflow: hidden;
  }
  .texto table.ficha thead { display: none; }
  .texto table.ficha td { padding: 0.8rem 1.25rem; vertical-align: top; }
  .texto table.ficha td[role='rowheader'] {
    width: 34%;
    font-size: var(--text-pequeno);
    font-weight: 600;
    color: var(--color-tinta-2);
    padding-top: 0.95rem;
  }
  .texto table.ficha tr + tr td { border-top: 1px solid color-mix(in srgb, var(--color-tinta) 10%, transparent); }
  .texto table.ficha td { border-bottom: 0; }
  @media (max-width: 639.98px) {
    .texto table.ficha,
    .texto table.ficha tbody,
    .texto table.ficha tr,
    .texto table.ficha td { display: block; width: 100% !important; }
    .texto table.ficha td[role='rowheader'] { padding-bottom: 0.1rem; }
    .texto table.ficha td:not([role='rowheader']) { padding-top: 0; border-top: 0 !important; }
  }

  /* Referências: texto que quebra linha (sem rolagem lateral), em cartão claro. O realce de
     sintaxe do Markdown é neutralizado: a referência é texto, não código. */
  .texto pre.citacao {
    background: var(--color-nevoa) !important;
    color: var(--color-tinta) !important;
    overflow-x: visible !important;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-cartao);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .texto pre.citacao span { color: inherit !important; }
  .texto pre.citacao:focus-visible { outline: 3px solid var(--color-ramo); outline-offset: 2px; }
  .cit-titulo-abnt { font-weight: 700; }
  .cit-titulo-apa { font-style: italic; }

  /* Contato: cartão com o link do próprio texto. */
  .texto p.contato-cartao {
    padding: 1.25rem 1.5rem;
    background: var(--color-nevoa);
    border-radius: var(--radius-cartao);
    border-left: 3px solid var(--color-semente);
  }
</style>
